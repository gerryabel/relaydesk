generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  savedViews      SavedView[]
  createdTickets  Ticket[]     @relation("TicketCreator")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  createdMessages Message[]    @relation("MessageCreator")
  internalNotes   InternalNote[] @relation("InternalNoteAuthor")
  activities      TicketActivity[] @relation("TicketActivityActor")
  notifications   Notification[]
  createdAutomationRules AutomationRule[] @relation("AutomationRuleCreator")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken           String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

enum WorkspaceRole {
  owner
  member
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketActivityType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CUSTOMER_LINKED
  CUSTOMER_UNLINKED
  TAG_ADDED
  TAG_REMOVED
  INTERNAL_NOTE_CREATED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  SLA_AT_RISK
}

model TicketActivity {
  id        String             @id @default(cuid())
  ticketId  String
  actorId   String?
  type      TicketActivityType
  metadata  Json?
  createdAt DateTime           @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([createdAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Public, non-sensitive identifier used for customer portal routing.
  /// Never used as an authorization credential — it is a lookup key only.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Membership[]
  tickets Ticket[]
  customers Customer[]
  tags     Tag[]
  notifications Notification[]
  savedViews SavedView[]
  automationRules AutomationRule[]
  automationExecutions AutomationExecution[]
  slaPolicies WorkspaceSlaPolicy[]
  customerMagicLinks CustomerMagicLink[]
  customerSessions CustomerSession[]
}

model WorkspaceSlaPolicy {
  id                String         @id @default(cuid())
  workspaceId       String
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, priority])
  @@index([workspaceId])
}

enum SavedViewType {
  tickets
  my_queue
}

model SavedView {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  type        SavedViewType @default(tickets)
  name        String

  filterState Json          @default("{}")
  sortState   Json          @default("{}")
  viewState   Json          @default("{}")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId])
  @@index([userId])
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([workspaceId])
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  customerMagicLinks CustomerMagicLink[]
  customerSessions CustomerSession[]

  // `@@index([workspaceId, email])` is retained from the original Customer
  // migration (20260813) — dropping it is out of scope for Phase 9 and would
  // require a separate DROP INDEX migration.
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@unique([workspaceId, email])
}

/**
 * Single-use, passwordless access token for the customer portal.
 *
 * Phase 9 Task 1: customers authenticate with a magic link instead of a
 * password. Only the SHA-256 digest of the token is persisted — the raw
 * value exists solely in the emailed link and in the async email payload.
 *
 * A magic link is always bound to exactly one (workspace, customer) pair and
 * is invalid once `consumedAt` is set or `expiresAt` has passed.
 */
model CustomerMagicLink {
  id          String    @id @default(cuid())
  workspaceId String
  customerId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([expiresAt])
}

/**
 * Opaque, revocable customer portal session.
 *
 * Deliberately separate from the Better Auth `Session` model: a customer
 * session must never satisfy workspace membership checks, and a workspace
 * user session must never grant customer portal access. Sessions are
 * workspace-scoped and are revoked by setting `revokedAt`.
 */
model CustomerSession {
  id          String    @id @default(cuid())
  workspaceId String
  customerId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([expiresAt])
}

model Ticket {
  id                  String         @id @default(cuid())
  workspaceId         String
  customerId          String?
  createdById         String?
  assignedToId        String?
  title               String
  description         String?
  status              TicketStatus   @default(open)
  priority            TicketPriority @default(medium)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  responseSlaDeadline DateTime?
  resolutionSlaDeadline DateTime?
  firstResponseAt     DateTime?
  resolvedAt          DateTime?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo  User?       @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages    Message[]
  internalNotes InternalNote[]
  activities  TicketActivity[]
  ticketTags  TicketTag[]
  notifications Notification[]
  automationExecutions AutomationExecution[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([customerId])
}

model Message {
  id          String   @id @default(cuid())
  ticketId    String
  createdById String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("MessageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([ticketId])
  @@index([createdById])
}

model InternalNote {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /**
   * Stable deduplication key for automation-created notes.
   * Set only when the note originates from an automation action.
   * Unique constraint guarantees at-most-one note per automation action
   * even under BullMQ redelivery.
   */
  automationDedupeKey String? @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets   TicketTag[]

  @@index([workspaceId])
  @@unique([workspaceId, normalizedName])
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
}

model Notification {
  id            String          @id @default(cuid())
  userId        String
  workspaceId   String
  ticketId      String?
  type          NotificationType
  title         String
  body          String
  readAt        DateTime?
  outboxEventId String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  /**
   * Stable deduplication key for automation-created notifications.
   * Set only when the notification originates from an automation action.
   * Unique constraint guarantees at-most-one notification per automation
   * action even under BullMQ redelivery.
   */
  automationDedupeKey String? @unique

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@index([ticketId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([processedAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model SentEmail {
  id             String   @id @default(cuid())
  outboxEventId  String   @unique
  recipient      String
  sentAt         DateTime @default(now())
  status         String   @default("SENT")
  claimedAt      DateTime?

  @@index([outboxEventId])
  @@index([claimedAt])
}

model SentSlaNotification {
  id        String   @id @default(cuid())
  ticketId  String
  slaType   String
  sentAt    DateTime @default(now())

  @@unique([ticketId, slaType])
  @@index([ticketId])
}

model Attachment {
  id                String   @id @default(cuid())
  messageId         String
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  storageKey        String   @unique
  createdAt         DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum AutomationExecutionStatus {
  pending
  evaluating
  awaiting_actions
  executing
  completed
  partial_failure
  failed
  skipped
}

enum AutomationActionExecutionStatus {
  pending
  completed
  failed
  skipped
}

model AutomationRule {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  enabled       Boolean  @default(true)
  priority      Int      @default(0)
  triggerType   String
  conditions    Json     @default("[]")
  actions       Json     @default("[]")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  executions AutomationExecution[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, enabled])
  @@index([workspaceId, triggerType, priority])
}

model AutomationExecution {
  id                  String                    @id @default(cuid())
  workspaceId         String
  ruleId              String?
  ruleNameSnapshot    String
  sourceEventType     String
  sourceEventId       String
  sourceAggregateId   String
  ticketId            String?
  status              AutomationExecutionStatus
  leasedBy            String?
  leasedAt            DateTime?
  evaluatedConditions Boolean                   @default(false)
  skipReason          String?
  error               String?
  startedAt           DateTime                  @default(now())
  completedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ticket    Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actions   AutomationActionExecution[]

  @@unique([sourceEventId, ruleId])
  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
  @@index([ticketId])
  @@index([workspaceId, status, createdAt])
  @@index([leasedAt])
  @@index([status, leasedBy, createdAt])
  @@index([status, leasedAt, createdAt])
}

model AutomationActionExecution {
  id           String                          @id @default(cuid())
  executionId  String
  actionIndex  Int
  actionType   String
  actionConfig Json
  status       AutomationActionExecutionStatus
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, actionIndex])
  @@index([executionId, status])
}

model SentSlaBreachNotification {
  id        String   @id @default(cuid())
  ticketId  String
  slaType   String
  sentAt    DateTime @default(now())

  @@unique([ticketId, slaType])
  @@index([ticketId])
}
